#!/usr/bin/env python3
"""Read-only pre-merge survey of this fork against its upstream.

Answers the question git will NOT answer for you: what breaks *without* producing a
conflict marker? Marked conflicts get read by whoever resolves them. The damage that
actually lands unnoticed is:

  1. DELETION BY REPLACEMENT - a symbol exists only in the fork, so resolving a file
     as "take upstream" removes it silently. No conflict marker, no failing test if
     nothing referenced it.

     Classified THREE ways against the merge base, because "absent upstream" has two
     very different causes. A symbol the fork INVENTED must survive the merge. A symbol
     that was in the merge base and upstream DELETED is a supersession, and dropping it
     is usually correct. The 2026-08-02 sync found exactly one of the latter
     (unified_diff_metadata, superseded by redact_deletion_only_secret_values) sitting
     in a list of 16 -- a two-way fork-vs-upstream diff calls it a fork feature and is
     wrong.

  2. SIGNATURE DRIFT - a function exists on both sides with a different signature or
     return type. If some call sites conflict and others auto-merge, a resolution can
     mix the two conventions and produce a runtime TypeError git never warned about.

  3. NEW OPTIONS WITH RESTRICTIVE DEFAULTS - upstream adds a CLI flag whose default
     narrows existing behaviour. Nothing conflicts and nothing fails to import, but
     runs behave differently and fixtures written before the flag quietly stop
     matching. The 2026-08-02 sync hit this with --max-priority (default P0), which
     filtered out the P1 findings three fork-only tests depended on.

All three are found by diffing ASTs, not text.

Runs entirely read-only: `git merge-tree --write-tree` computes the merge in the object
store without touching the worktree or the index. Nothing here mutates the repository.

Usage:
    scripts/upstream-survey [--ref upstream/main] [--quiet]

Exit status is 0 whenever the survey completes; a non-empty conflict surface is a fact
to read, not a failure. Exit 2 means the survey itself could not run.
"""
from __future__ import annotations

import argparse
import ast
import subprocess
import sys
from pathlib import Path


def run(*args: str, check: bool = True) -> str:
    result = subprocess.run(
        ["git", *args], capture_output=True, text=True, cwd=REPO_ROOT
    )
    if check and result.returncode != 0:
        raise SystemExit(f"upstream-survey: `git {' '.join(args)}` failed: {result.stderr.strip()}")
    return result.stdout


def blob(ref: str, path: str) -> str | None:
    result = subprocess.run(
        ["git", "show", f"{ref}:{path}"], capture_output=True, text=True, cwd=REPO_ROOT
    )
    return result.stdout if result.returncode == 0 else None


def looks_like_python(path: str, source: str | None) -> bool:
    if source is None:
        return False
    if path.endswith(".py"):
        return True
    first = source.split("\n", 1)[0]
    return first.startswith("#!") and "python" in first


def top_level_defs(source: str) -> dict[str, str]:
    """Map every module-level function name to a normalized signature string."""
    try:
        tree = ast.parse(source)
    except SyntaxError:
        return {}
    out: dict[str, str] = {}
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            returns = ast.unparse(node.returns) if node.returns else "<none>"
            params = ", ".join(
                a.arg + (f": {ast.unparse(a.annotation)}" if a.annotation else "")
                for a in [*node.args.posonlyargs, *node.args.args, *node.args.kwonlyargs]
            )
            out[node.name] = f"({params}) -> {returns}"
    return out


def cli_options(source: str) -> dict[str, str]:
    """Map every add_argument() option string to its `default=` expression."""
    try:
        tree = ast.parse(source)
    except SyntaxError:
        return {}
    out: dict[str, str] = {}
    for node in ast.walk(tree):
        if not (isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute)):
            continue
        if node.func.attr != "add_argument" or not node.args:
            continue
        first = node.args[0]
        if not (isinstance(first, ast.Constant) and isinstance(first.value, str)):
            continue
        if not first.value.startswith("-"):
            continue
        default = next(
            (ast.unparse(kw.value) for kw in node.keywords if kw.arg == "default"),
            "<no default>",
        )
        out[first.value] = default
    return out


def conflict_surface(ref: str) -> dict[str, int]:
    """Files git will mark as conflicted, with the number of conflict hunks in each."""
    result = subprocess.run(
        ["git", "merge-tree", "--write-tree", ref, "HEAD"],
        capture_output=True, text=True, cwd=REPO_ROOT,
    )
    if not result.stdout.strip():
        raise SystemExit(f"upstream-survey: merge-tree produced no output: {result.stderr.strip()}")
    tree = result.stdout.splitlines()[0].strip()
    files = [
        line.split("Merge conflict in ", 1)[1].strip()
        for line in result.stdout.splitlines()
        if "Merge conflict in " in line
    ]
    surface: dict[str, int] = {}
    for path in files:
        merged = blob(tree, path) or ""
        surface[path] = sum(1 for ln in merged.splitlines() if ln.startswith("<<<<<<<"))
    return surface


def main() -> int:
    parser = argparse.ArgumentParser(description="Read-only pre-merge survey against upstream.")
    parser.add_argument("--ref", default="upstream/main", help="upstream ref (default: upstream/main)")
    parser.add_argument("--quiet", action="store_true", help="suppress the clean-file lines")
    args = parser.parse_args()
    ref = args.ref

    if not run("rev-parse", "--verify", "--quiet", ref, check=False).strip():
        print(f"upstream-survey: ref {ref!r} not found. Try: git fetch upstream", file=sys.stderr)
        return 2

    base = run("merge-base", ref, "HEAD").strip()
    behind, ahead = run("rev-list", "--left-right", "--count", f"{ref}...HEAD").split()

    print("=" * 74)
    print(f"UPSTREAM SURVEY  {ref}")
    print("=" * 74)
    print(f"  merge-base   {base}")
    print(f"  upstream tip {run('rev-parse', ref).strip()}")
    print(f"  fork tip     {run('rev-parse', 'HEAD').strip()}")
    print(f"  drift        {behind} behind / {ahead} ahead")

    if behind == "0":
        print("\nAlready up to date with upstream. Nothing to survey.")
        return 0

    surface = conflict_surface(ref)
    print(f"\nMARKED CONFLICTS -- git will flag these ({len(surface)} files, "
          f"{sum(surface.values())} hunks)")
    if not surface:
        print("  (none)")
    for path, hunks in sorted(surface.items(), key=lambda kv: -kv[1]):
        print(f"  {hunks:>4}  {path}")

    # The silent traps. Scan every Python file that differs between the two sides --
    # NOT just the conflicted ones. A file that auto-merges cleanly is exactly where
    # this damage hides.
    changed = {
        line.strip()
        for line in run("diff", "--name-only", f"{base}..{ref}").splitlines()
        if line.strip()
    }

    fork_added: list[tuple[str, list[str]]] = []
    superseded: list[tuple[str, list[str]]] = []
    drift: list[tuple[str, list[tuple[str, str, str]]]] = []
    new_options: list[tuple[str, list[tuple[str, str]]]] = []

    for path in sorted(changed):
        up_src, fork_src = blob(ref, path), blob("HEAD", path)
        if fork_src is None or up_src is None:
            continue  # added or removed wholesale; git handles those visibly
        if not (looks_like_python(path, fork_src) and looks_like_python(path, up_src)):
            continue
        base_src = blob(base, path) or ""
        fork_defs, up_defs = top_level_defs(fork_src), top_level_defs(up_src)
        base_defs = top_level_defs(base_src)
        if not fork_defs:
            continue

        # "Absent upstream" has two causes with opposite resolutions. Split them.
        gone = sorted(set(fork_defs) - set(up_defs))
        invented = [n for n in gone if n not in base_defs]
        removed = [n for n in gone if n in base_defs]
        if invented:
            fork_added.append((path, invented))
        if removed:
            superseded.append((path, removed))

        changed_sigs = [
            (name, fork_defs[name], up_defs[name])
            for name in sorted(set(fork_defs) & set(up_defs))
            if fork_defs[name] != up_defs[name]
        ]
        if changed_sigs:
            drift.append((path, changed_sigs))

        fork_opts, up_opts = cli_options(fork_src), cli_options(up_src)
        added_opts = sorted(
            (opt, up_opts[opt]) for opt in set(up_opts) - set(fork_opts)
        )
        changed_defaults = sorted(
            (opt, f"{fork_opts[opt]} -> {up_opts[opt]}")
            for opt in set(up_opts) & set(fork_opts)
            if fork_opts[opt] != up_opts[opt]
        )
        if added_opts or changed_defaults:
            new_options.append((path, added_opts + changed_defaults))

    print("\nSILENT TRAP 1a -- FORK-ADDED symbols (a 'take upstream' resolution deletes these)")
    if not fork_added:
        print("  (none)")
    for path, names in fork_added:
        print(f"  {path}")
        for name in names:
            print(f"      - {name}")

    print("\nSILENT TRAP 1b -- UPSTREAM-DELETED symbols (supersessions; dropping is usually right)")
    if not superseded:
        print("  (none)")
    for path, names in superseded:
        print(f"  {path}")
        for name in names:
            print(f"      - {name}  (present in merge base; upstream removed it)")

    print("\nSILENT TRAP 2 -- signature drift (may auto-merge into a mixed convention)")
    if not drift:
        print("  (none)")
    for path, sigs in drift:
        print(f"  {path}")
        for name, fork_sig, up_sig in sigs:
            print(f"      {name}")
            print(f"          fork:     {fork_sig}")
            print(f"          upstream: {up_sig}")

    print("\nSILENT TRAP 3 -- new/changed CLI defaults (narrow behaviour without failing)")
    if not new_options:
        print("  (none)")
    for path, opts in new_options:
        print(f"  {path}")
        for opt, default in opts:
            print(f"      {opt:<28} default: {default}")

    print("\nNext: docs/UPSTREAM-SYNC.md -- resolution policy and the authorization this needs.")
    return 0


REPO_ROOT = Path(__file__).resolve().parent.parent

if __name__ == "__main__":
    raise SystemExit(main())
