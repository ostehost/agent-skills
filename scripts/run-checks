#!/usr/bin/env bash
# Run the same checks .github/workflows/validate.yml runs, locally and in one command.
# Mirrors that workflow step-for-step so a green run here means a green run in CI.
# Directly runnable, no build step (AGENTS.md "Architecture").
#
# INTERPRETER: uses `python3`/`node` from PATH, falling back to the in-repo .venv
# only for the two steps that import PyYAML. The autoreview interpreter guard
# (find_command, skills/autoreview/scripts/autoreview) still refuses any executable
# inside the repo under review, but the self-tests that made an in-repo interpreter
# fail outright were removed upstream in the 2026-08-20 sync; the remaining suites
# pass under either interpreter. Prefer an interpreter outside this tree anyway.
set -uo pipefail
# Fail loudly rather than checking whatever directory we happen to be in.
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" \
  || { echo "run-checks: cannot cd to the repository root" >&2; exit 2; }

PY="${PYTHON:-python3}"
NODE="${NODE:-node}"
failed=()

step() { # step <name> <cmd...>
  local name="$1"; shift
  if "$@" >/tmp/run-checks.$$ 2>&1; then
    printf '  ok    %s\n' "$name"
  else
    printf '  FAIL  %s\n' "$name"
    sed 's/^/          /' /tmp/run-checks.$$ | tail -25
    failed+=("$name")
  fi
  rm -f /tmp/run-checks.$$
}

command -v "$PY"   >/dev/null || { echo "run-checks: $PY not on PATH" >&2; exit 2; }
command -v "$NODE" >/dev/null || { echo "run-checks: $NODE not on PATH" >&2; exit 2; }

# Only validate-skills and its test import PyYAML; every other step runs on a bare
# interpreter. CI installs requirements-dev.txt into its setup-python, so one interpreter
# covers everything there. Locally the repo's own .venv/ (gitignored) usually carries
# PyYAML, and it is safe for these two steps precisely because they are plain repo tooling
# that never re-invokes autoreview, so the interpreter guard never sees it.
PY_YAML="$PY"
if ! "$PY" -c 'import yaml' 2>/dev/null; then
  if [ -x .venv/bin/python ] && .venv/bin/python -c 'import yaml' 2>/dev/null; then
    PY_YAML="$PWD/.venv/bin/python"
  else
    echo "run-checks: PyYAML missing for $PY and no usable .venv." >&2
    echo "            Run: $PY -m pip install -r requirements-dev.txt" >&2
    exit 2
  fi
fi

echo "run-checks ($("$PY" -V 2>&1), $("$NODE" --version))"
[ "$PY_YAML" = "$PY" ] || echo "  note  PyYAML steps use $PY_YAML"

step "validate skill frontmatter" \
  "$PY_YAML" scripts/validate-skills

step "check shell scripts" \
  bash -n skills/autoreview/scripts/test-review-harness

step "check python scripts" \
  "$PY" -m py_compile \
    scripts/install-skills scripts/install-skills.test.py \
    scripts/upstream-survey \
    scripts/validate-skills scripts/validate-skills.test.py \
    skills/autoreview/scripts/autoreview \
    skills/autoreview/scripts/test-review-harness.py \
    skills/autoreview/scripts/autoreview_test.py \
    skills/autoreview/tests/test_receipt_contract.py \
    skills/autoreview/tests/test_merge_invariants.py

step "repository script tests: install-skills" "$PY" scripts/install-skills.test.py
step "repository script tests: validate-skills" "$PY_YAML" scripts/validate-skills.test.py

# Keep this module list byte-identical to the "Run Python tests" step in
# .github/workflows/validate.yml -- the two gates must not drift.
step "python tests" \
  "$PY" -m unittest skills/autoreview/scripts/autoreview_test.py \
    skills.autoreview.tests.test_autoreview_hardening \
    skills.autoreview.tests.test_receipt_contract \
    skills.autoreview.tests.test_merge_invariants

step "check node scripts" \
  "$NODE" --check skills/agent-transcript/scripts/agent-transcript
step "check node scripts: beam" \
  "$NODE" --check skills/beam/scripts/beam
step "check node scripts: beam-session" \
  "$NODE" --check skills/beam/scripts/beam-session.js

step "node tests" \
  "$NODE" --test skills/agent-transcript/scripts/agent-transcript.test.mjs \
    skills/beam/scripts/beam.test.mjs \
    skills/session-viewer/scripts/session-viewer.test.ts

# CI gates these to Linux (the matrix's other leg is Windows, which lacks jq/bash).
# Any POSIX box with jq can run them, so gate on the dependency, not the OS.
if command -v jq >/dev/null; then
  step "design-competition conformance (C1-C8)" skills/design-competition/scripts/check-conformance.sh
  step "design-competition script tests"        skills/design-competition/scripts/scripts.test.sh
else
  echo "  skip  design-competition suites (jq not on PATH)"
fi

if [ ${#failed[@]} -eq 0 ]; then
  echo "ALL CHECKS PASSED"
else
  printf '\n%d CHECK(S) FAILED:\n' "${#failed[@]}" >&2
  printf '  - %s\n' "${failed[@]}" >&2
  exit 1
fi
