#!/usr/bin/env bash
# Per-repo pre-push gate — this repository's ONLY push gate.
#
# No justfile exists here by policy (upstream-facing skills fork; see
# AGENTS.md "Commands"), so the governed global hook
# (~/.config/git/hooks/pre-push) has nothing to run for this repo: its
# `just ci` branch never engages, and its ecosystem auto-detection
# (biome/eslint/bun/npm/cargo/go) matches nothing in a plain-scripts
# Python/Node tree. Before this file existed, a push ran ZERO checks and
# still printed success.
#
# scripts/run-checks is the gate: upstream's scripts/check-skills (what
# validate.yml runs) followed by the fork-only scripts/check-fork (what
# fork-validate.yml runs). It runs the same entrypoints as CI, not a
# step-for-step copy of either workflow, and it does not cover validate.yml's
# installed-source or macos-sandbox jobs.
#
# It is deliberately fail-closed and refuses to start (exit 2) unless:
#   - PYTHON (default python3) is an interpreter OUTSIDE this checkout with
#     PyYAML and Pillow installed (`<python> -m pip install -r
#     requirements-dev.txt`); an in-repo .venv is refused, because autoreview
#     refuses in-repo interpreters;
#   - the temporary directory is private (on macOS, not /tmp or /var/tmp);
#   - node, npm and node_modules exist (`npm ci --ignore-scripts`).
# Fix the environment rather than bypassing; a gate that self-skips on
# missing tools is a false green.
#
# RAN_JUST_CI can never be 1 here (no justfile), so there is nothing to
# coordinate with. If a justfile with a `ci` recipe ever lands, add the
# RAN_JUST_CI skip — see config/.githooks/pre-push for the pattern.
# Emergency bypass (discouraged): git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "🧪 [agent-skills] scripts/run-checks (check-skills + check-fork)…"
exec scripts/run-checks
